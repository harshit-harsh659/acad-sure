```gitignore
# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Frontend - React / Vite
# =========================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# =========================
# Backend - Django / Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
backend/venv/
backend/.venv/
venv/
.venv/

# Django database
backend/db.sqlite3
db.sqlite3

# Django environment files
backend/.env
backend/.env.*
!backend/.env.example

# User-uploaded media
backend/media/

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# Editor directories and files
# =========================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
```
